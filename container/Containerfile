# Build environment for a Wreckless binary that runs on SteamOS
# (glibc 2.41) as well as on newer systems: Ubuntu 24.04 (glibc 2.39) with
# Clang 20 from apt.llvm.org. The last RUN adds what this game
# needs: SDL2, libepoxy, OpenSSL, glslang and SPIRV-Tools.
# Used by deck-build.sh. The file is Double-S.T.E.A.L 2's (same studio, same
# libraries), so its image, localhost/ds2-build:24.04, serves both games.
FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates gnupg wget git cmake ninja-build python3 pkg-config file nasm \
      libgtk-3-dev libx11-dev libx11-xcb-dev libxext-dev libxrandr-dev libxcursor-dev libxi-dev \
      libxss-dev libxfixes-dev libxtst-dev libxkbcommon-dev libwayland-dev libwayland-bin \
      wayland-protocols libdecor-0-dev libegl-dev libgl-dev libgbm-dev libdrm-dev libvulkan-dev \
      libasound2-dev libpulse-dev libpipewire-0.3-dev libdbus-1-dev libudev-dev \
      libusb-1.0-0-dev libfribidi-dev libthai-dev libunwind-dev \
 && wget -qO /etc/apt/trusted.gpg.d/apt.llvm.org.asc https://apt.llvm.org/llvm-snapshot.gpg.key \
 && echo "deb http://apt.llvm.org/noble/ llvm-toolchain-noble-20 main" > /etc/apt/sources.list.d/llvm-20.list \
 && apt-get update && apt-get install -y --no-install-recommends clang-20 lld-20 llvm-20 \
 && rm -rf /var/lib/apt/lists/*
RUN git config --system --add safe.directory '*'
ENV CC=clang-20 CXX=clang++-20 PATH=/usr/lib/llvm-20/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
      libsdl2-dev libepoxy-dev libssl-dev glslang-dev glslang-tools spirv-tools \
 && rm -rf /var/lib/apt/lists/*
